# ===== Server =====
PORT=8787
# Token rahasia untuk aplikasi Android (min 24 karakter). Buat dengan: openssl rand -hex 32
APP_TOKEN=GANTI_DENGAN_TOKEN_ACAK_MINIMAL_24_KARAKTER

# ===== 9Router =====
# Base URL OpenAI-compatible 9Router (default 9Router: http://localhost:20128/v1)
NINEROUTER_BASE_URL=http://localhost:20128/v1
# Isi jika 9Router memakai REQUIRE_API_KEY=true (salin dari dashboard 9Router)
NINEROUTER_API_KEY=
# Nama Combo default (mode Fallback diatur di dashboard 9Router), contoh: my-combo
NINEROUTER_DEFAULT_MODEL=

# ===== Penyimpanan & batas =====
DATA_DIR=./data
MAX_UPLOAD_MB=15
MAX_GENERATED_FILE_MB=5
MAX_WORKSPACE_MB=50
MAX_WORKSPACE_FILES=300
MAX_ZIP_UNCOMPRESSED_MB=60
MAX_ATTACHMENT_CHARS=60000
MAX_CONTEXT_CHARS=200000

# Origin web yang boleh mengakses backend (pisahkan dengan koma), tanpa path/slash akhir
CORS_ORIGIN=https://USERNAME.github.io
